%% load all tables.
resultTables = dir('/media/yarinms/Data2/Projects/MarvinRuns/3Vis/Results_Table*');
NET = 0;
mainWDtab = table();
for Itab = 1 : length(resultTables)

    tab = load(fullfile(resultTables(Itab).folder,resultTables(Itab).name));

    if ~isempty(tab.MetaTable)
         NET = NET +1 ;
         Tab = tab.MetaTable;
         WDtab = Tab(Tab.Pwd> 0 ,:);
         mainWDtab = vertcat(mainWDtab,WDtab);
    end


end

%%

% Basic statistics for key columns
disp('Basic Statistics:');
fprintf('Total rows (detections): %d\n', height(wdTable));
fprintf('Unique WDs (RA, Dec pairs): %d\n', height(unique(wdTable(:, {'RA', 'Dec'}))));
fprintf('Mean number of candidates in subimages: %.2f\n', mean(wdTable.NcandInSubImage));
fprintf('Median total visits: %.2f\n', median(wdTable.totalVisits));
fprintf('Maximum total visits: %d\n', max(wdTable.totalVisits));
fprintf('WD with brightest AbsMag (min value): %.2f\n', min(wdTable.AbsMag));
fprintf('WD with faintest AbsMag (max value): %.2f\n', max(wdTable.AbsMag));



%% if not empty get WDs rows.
fprintf('Nwds = %i',height(mainWDtab))
wdTable = sortrows(mainWDtab, 'MaxPS', 'descend')
for i = 1 :5%height(wdTable)

    figure()
    t = datetime(wdTable.JD{i},'convertfrom','jd');
    plot(t,wdTable.MAG_PSF{i},'k-o')

    title(sprintf('(%.4f,%.4f)  $P_{wd}$ -  %.2f; WD row %i',wdTable.RA(i),wdTable.Dec(i), wdTable.Pwd(i),i))
    xlabel(sprintf('Abs  $G$ = %.2f; $B_p-R_p$ = %.3f\n %s %04d-%02d-%02d %s',wdTable.AbsMag(i),wdTable.BpRp(i),wdTable.TelescopeID(i,:),wdTable.Year(i),wdTable.Month(i),wdTable.Day(i),wdTable.FieldID{i}))
    set(gca,'YDir','reverse')
end



%%
% Initialize the flag array
wdTable = sortrows(largestTable(largestTable.RMF & largestTable.PS,:), 'maxRMF', 'descend');
flags = false(height(wdTable), 1); % False for all rows initially

% Sort the table by maxRMF in descending order
wdTable = sortrows(wdTable, 'maxRMF', 'descend');

% Iterate through the rows and plot the light curves
for i = 1:500 %height(wdTable)
    % Plot the light curve
    figure();
    t = datetime(wdTable.JD{i}, 'convertfrom', 'jd');
    plot(t, wdTable.MAG_PSF{i}, 'k-o', 'LineWidth', 1.5);
    set(gca, 'YDir', 'reverse'); % Reverse the Y-axis for magnitude
    
    % Title and labels
    title(sprintf('(%.4f,%.4f)  $P_{wd}$ -  %.2f; WD row %i', ...
          wdTable.RA(i), wdTable.Dec(i), wdTable.Pwd(i), i), ...
          'Interpreter', 'latex');
    xlabel(sprintf('Abs  $G$ = %.2f; $B_p-R_p$ = %.3f\n %s %04d-%02d-%02d %s', ...
          wdTable.AbsMag(i), wdTable.BpRp(i), wdTable.TelescopeID(i,:), ...
          wdTable.Year(i), wdTable.Month(i), wdTable.Day(i), ...
          wdTable.FieldID{i}), ...
          'Interpreter', 'latex');
    ylabel('MAG_PSF');
    
    % Ask user if they want to flag the WD
    flagInput = input('Flag this WD? (y/n): ', 's');
    if strcmpi(flagInput, 'y')
        flags(i) = true; % Mark this row as flagged
    end
    
    % Close the figure
    close(gcf);
end

% Add the flags to the table for future reference
wdTable.Flagged = flags;

% Save the flagged table (optional)
%save('Flagged_wdTable.mat', 'wdTable');

% Phase space plot with flagged rows highlighted
figure();
scatter(wdTable.maxRMF(~flags), wdTable.MaxPS(~flags), 30, 'b', 'filled'); % Non-flagged WDs
hold on;
scatter(wdTable.maxRMF(flags), wdTable.MaxPS(flags), 80, 'r', 'filled', 'MarkerEdgeColor', 'k'); % Flagged WDs
xlabel('maxRMF');
ylabel('MaxPS');
title('Phase Space: maxRMF vs MaxPS (Flagged WDs Highlighted)');
legend({'Non-Flagged', 'Flagged'}, 'Location', 'best');
hold off;



%% WD rows statistics
[uniqueWDs,idx,uix] = unique(wdTable(:, {'RA', 'Dec'}));
disp('Unique WDs with frequencies:');
disp(uniqueWDs);
