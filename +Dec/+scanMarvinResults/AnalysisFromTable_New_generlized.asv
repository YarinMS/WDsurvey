%% Load gaia data;
gaiaData = load('~/Documents/WDsurvey/gaia_bp_rp_mg.mat');


%% Go over path load tables
visID = '20Vis'
resultTables = dir(sprintf('/media/yarinms/Data2/Projects/NightlyRun1/%s/*Results_Table*',visID));



%%
gtab = table();

for Itab = 1 : numel(resultTables)
    tab = load(fullfile(resultTables(Itab).folder,resultTables(Itab).name));
    if ~isempty(tab)
     tab = tab.MetaTable;
     gtab = vertcat(gtab,tab);
    end
end


%% Analysis and plots


disp(sprintf('%i WD events',sum(gtab.Pwd>0)))

%% plot maxRMF correlation with background 
plts.plotNTabStat(gtab,'gaiaData',gaiaData,'Xfield','C_Chi2','Yfield','RMSNsigma')